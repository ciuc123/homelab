# Repository secrets used by .github/workflows/provision-client.yml (Settings -> Secrets and variables -> Actions).
# Never commit real values.
CF_API_TOKEN=      # Cloudflare token: Zone.DNS edit on the one zone
CF_ZONE_ID=
CF_ZONE_NAME=      # for example example.com; clients are subdomains of it
VERCEL_TOKEN=
VERCEL_TEAM_ID=    # optional
NEON_API_KEY=
GH_PAT=            # repo + workflow: creates the client repos and reads infra-template
NPM_TOKEN=         # read:packages for the private @ciuc123/app-core
