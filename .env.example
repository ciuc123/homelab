# Repository secrets used by .github/workflows/provision-client.yml (Settings -> Secrets and variables -> Actions).
# Never commit real values.
CF_API_TOKEN=      # Cloudflare token: Zone.DNS edit on the one zone
CF_ZONE_ID=
CF_ZONE_NAME=      # for example example.com; clients are subdomains of it
VERCEL_TOKEN=
VERCEL_TEAM_ID=    # optional
NEON_API_KEY=
GH_PAT=            # repo + workflow: creates the client repos and reads infra-template
NPM_TOKEN=         # read:packages for the private @ciuc123/app-core
CLERK_PLATFORM_API_KEY=   # optional: ak_... Clerk Platform API key; creates each client's Clerk application
# Usage guard (.github/workflows/usage-guard.yml) also uses VERCEL_TOKEN, NEON_API_KEY and GH_PAT above.
SENTRY_AUTH_TOKEN=   # optional: personal token, org:read project:read project:write (uptime monitors)
RESEND_API_KEY=      # optional: sending access on the USAGE_EMAIL_FROM domain
# Variables, not secrets (gh variable set): USAGE_EMAIL_TO, USAGE_EMAIL_FROM, USAGE_STATE_REPO, USAGE_GUARD_REF, USAGE_APPLY
